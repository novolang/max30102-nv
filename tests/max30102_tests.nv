// ── The bring-up ─────────────────────────────────────────────────────

@test
fn test_start_writes_the_default_configuration_and_releases_the_interrupt() [io, hw]
    let c = chip()
    // After power-up PWR_RDY holds INT low until the status is read.
    c.st.insert(30, 0x01)
    c.regs.insert(0x02, 0xFF)
    let d = dut(c)
    test.assert(max30102.start(d, max30102.config_default()))
    test.assert_eq(reg_of(c, 0x08), 0x4A)
    test.assert_eq(reg_of(c, 0x0A), 0x2F)
    test.assert_eq(reg_of(c, 0x0C), 0x1F)
    test.assert_eq(reg_of(c, 0x0D), 0x1F)
    test.assert_eq(reg_of(c, 0x09), 0x03)
    test.assert_eq(reg_of(c, 0x02), 0)
    test.assert_eq(at(c.st, 30), 0)
    test.assert_eq(at(c.st, 20) + at(c.st, 21) + at(c.st, 22), 0)

@test
fn test_the_mode_is_written_last_so_sampling_starts_on_a_clean_fifo() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(max30102.configure(d, max30102.config_default()))
    let n = at(c.st, 99)
    // The last entry before the end is the MODE_CONFIG write.
    test.assert_eq(at(c.log, n - 4), 1)
    test.assert_eq(at(c.log, n - 3), 0x09)
    test.assert_eq(at(c.log, n - 2), 0x03)
    // The FIFO was cleared before it.
    test.assert_eq(at(c.log, n - 9), 0x04)

@test
fn test_heart_rate_mode_starts_in_mode_2() [io, hw]
    let c = chip()
    let hr = Max30102Config { spo2: false, averaging: 2, rollover: true, full_empty: 4, rate_sps: 200, pulse_us: 215, adc_na: 8192, red_pa: 0x30, ir_pa: 0 }
    test.assert(max30102.start(dut(c), hr))
    test.assert_eq(reg_of(c, 0x09), 0x02)
    test.assert_eq(reg_of(c, 0x08), 0x20 | 0x10 | 0x04)

@test
fn test_start_refuses_a_part_that_is_not_a_max30102() [io, hw]
    let c = chip()
    c.regs.insert(0xFF, 0x00)
    test.assert(not max30102.start(dut(c), max30102.config_default()))
    let c2 = chip()
    c2.st.insert(4, 0)
    test.assert(not max30102.start(dut(c2), max30102.config_default()))
    let spi = Dut { bus: FakeI2c { c: chip() }, pins: pins(), c: chip(), w: DeviceWiring { bus: 0, addr: None, cs: Some(3), irq: None, en: None } }
    test.assert(not max30102.start(spi, max30102.config_default()))

@test
fn test_start_fails_on_any_one_failed_transaction() [io, hw]
    let c = chip()
    c.st.insert(10, 2)
    test.assert(max30102.start(dut(c), max30102.config_default()))
    let n = at(c.st, 1)
    for k in 1..(n + 1)
        let c2 = chip()
        c2.st.insert(10, 2)
        c2.st.insert(2, k)
        test.assert(not max30102.start(dut(c2), max30102.config_default()))

@test
fn test_start_fails_when_the_reset_never_ends() [io, hw]
    let c = chip()
    c.st.insert(10, 1000000)
    test.assert(not max30102.start(dut(c), max30102.config_default()))

// ── The type over the host's board handles ───────────────────────────
//
// The host's I2C bus is absent hardware: every transfer is refused, so
// each method answers its "no part" value.

@test
fn test_the_type_over_absent_hardware() [io, hw]
    let p = Max30102.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, wiring())
    test.assert(p.now_us() >= 0)
    test.assert(not p.begin())
    test.assert(not p.begin_with(max30102.config_default()))
    test.assert(p.reg(0xFF) == None)
    test.assert(not p.set_reg(0x30, 1))
    test.assert(not p.shutdown(true))
    test.assert(not p.clear_fifo())
    test.assert_eq(p.fifo_count(), -1)
    test.assert(not p.set_almost_full(5))
    test.assert(not p.interrupts_enable(0x8000))
    test.assert_eq(p.interrupts_read(), -1)
    test.assert(p.temperature_milli_c() == None)
    test.assert_eq(p.int_level(), 0)
    test.assert_eq(p.ppg_set_rate_hz(100), 0)
    test.assert_eq(p.ppg_set_led_ma(PpgLed.PpgRed, 6), 0)
    test.assert_eq(p.ppg_lost(), 0)
    var out: Vec[PpgSample; 32] = Vec.new()
    test.assert_eq(p.ppg_drain(var out), -1)
    test.assert(p.device_id() == None)

@test
fn test_the_almost_full_level_changes_only_its_own_bits() [io, hw]
    let c = running()
    let d = dut(c)
    test.assert(max30102.upd(d, 0x08, 0x0F, 3))
    test.assert_eq(reg_of(c, 0x08), 0x43)
